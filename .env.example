# ============================================
# StudioSpace Backend (Express.js)
# Copy this file to .env and fill in real values.
# ============================================

# MongoDB connection string
MONGODB_URI=mongodb://user:password@host:27017/studiospace?ssl=true

# Secret used to sign the `studio_jwt` cookie.
# Must be identical to JWT_SECRET on the frontend.
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins.
# Local development:
#   FRONTEND_URL=http://localhost:3000
# Production:
#   FRONTEND_URL=https://studio-space-client-steel.vercel.app
FRONTEND_URL=http://localhost:3000

# Port the server listens on when running locally (Vercel overrides this).
PORT=3001